      "product design",
      "ux design",
      "ui design",
      "user research",
      "design systems",
      "wireframe",
      "prototyp",
      "figma",
      "עיצוב מוצר",
      "עיצוב UX",
      "עיצוב UI",
      "מחקר משתמשים"
    ],
    "exclude": [
      "graphic designer only (print)",
      "motion designer only",
      "3d artist",
      "game artist",
      "interior design"
    ]
  },
  "seniority_filter": ["junior", "mid", "senior"],
  "locations": {
    "primary": ["Tel Aviv", "Ramat Gan", "Herzliya", "Petah Tikva", "Israel"],
    "accept_remote": true,
    "accept_hybrid": true
  },
