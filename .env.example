# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Job sources
SERPAPI_KEY=

# Daily cron -> API route auth. Generate with: openssl rand -hex 32
# Only needed by /api/cron (a manual-trigger convenience); the GitHub Actions
# workflow runs scripts/run-daily-scan.mts directly and doesn't use this.
CRON_SECRET=

# Dashboard password protection
SITE_PASSWORD=

# Optional: daily email digest
RESEND_API_KEY=
